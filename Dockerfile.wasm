# The wasm broker as a container: the SAME www/pkg bytes a browser page
# loads (ONE artifact everywhere — browser, bare node, docker), fronted by
# the Node shim so the ETSI suite reaches it over TCP.
#
# Build www/pkg first: dev/wasm-build.sh. Store selection is the shim's:
#   ANTARES_STORE=memory|file, ANTARES_FILE=<redb path> (mount /data).
#
#   docker build -f Dockerfile.wasm -t antares-wasm-local .
#   docker run --network host -e ANTARES_STORE=file \
#     -e ANTARES_FILE=/data/antares.redb -v wasmdata:/data \
#     antares-wasm-local 9090
FROM node:22-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436
WORKDIR /app
COPY www/pkg ./pkg
COPY www/node-shim.mjs ./node-shim.mjs
# The shim needs nothing but read access to its own bundle, so it runs as the
# image's unprivileged user. `file` mode writes to /data: a fresh named volume
# inherits the mountpoint's ownership, so the directory is pre-created for
# that user — nothing chowns at runtime. A BIND mount keeps the host
# directory's ownership instead, so a caller mounting one passes
# `--user "$(id -u):$(id -g)"` and stays unprivileged that way.
RUN mkdir /data && chown node:node /data
USER node
ENTRYPOINT ["node", "node-shim.mjs"]
CMD ["9090"]

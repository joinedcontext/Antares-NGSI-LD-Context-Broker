{
  "name": "antares-www",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The React playground + wasm glue (pkg, worker, node shim) + browser-tier tests",
  "scripts": {
    "sync": "rm -rf public/pkg && mkdir -p public && cp -r pkg public/pkg && cp worker.js loopback.js public/",
    "dev": "vite",
    "build": "npm run sync && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "npm run build && node e2e/smoke.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12",
    "react": "^19",
    "react-dom": "^19",
    "swagger-ui-dist": "^5.33.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
